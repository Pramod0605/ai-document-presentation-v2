{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "spec_version",
    "presentation_id",
    "subject",
    "grade",
    "chapter_title",
    "avatar_global",
    "sections"
  ],
  "properties": {
    "spec_version": {
      "const": "v1.3"
    },
    "presentation_id": { "type": "string" },
    "subject": { "type": "string" },
    "grade": { "type": "string" },
    "chapter_title": { "type": "string" },

    "avatar_global": {
      "type": "object",
      "required": [
        "style",
        "default_position",
        "default_width_percent",
        "gesture_enabled"
      ],
      "properties": {
        "style": { "enum": ["teacher", "guide"] },
        "default_position": { "enum": ["left", "right"] },
        "default_width_percent": { "type": "number", "minimum": 20, "maximum": 60 },
        "gesture_enabled": { "type": "boolean" }
      }
    },

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/memory_section" },
          { "$ref": "#/$defs/recap_section" },
          { "$ref": "#/$defs/generic_section" }
        ]
      }
    }
  },

  "$defs": {
    "base_section": {
      "type": "object",
      "required": [
        "section_id",
        "section_type",
        "title",
        "renderer",
        "avatar_layout",
        "narration",
        "visual_beats"
      ],
      "properties": {
        "section_id": { "type": "number" },
        "title": { "type": "string" },
        "renderer": { "enum": ["manim", "remotion", "video"] },
        "avatar_layout": {
          "type": "object",
          "required": ["visibility"],
          "properties": {
            "visibility": { "enum": ["required", "optional", "hidden"] },
            "mode": { "type": "string", "description": "Layout mode - side, overlay, hidden, center, gesture_only, etc." },
            "position": { "type": "string", "description": "Position for avatar - left, right, center, bottom_right, bottom_left, etc." },
            "width_percent": { "type": "number", "minimum": 10, "maximum": 70 }
          }
        },
        "narration": {
          "type": "object",
          "required": ["full_text", "segments"],
          "properties": {
            "full_text": { "type": "string", "minLength": 50 },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/narration_segment" }
            }
          }
        },
        "video_prompts": {
          "type": "array",
          "description": "Video prompts for WAN/video renderer sections",
          "items": { "$ref": "#/$defs/video_prompt" }
        },
        "manim_scene_spec": {
          "type": "object",
          "description": "Manim scene specification for manim renderer sections"
        },
        "remotion_scene_spec": {
          "type": "object",
          "description": "Remotion scene specification for remotion renderer sections"
        },
        "renderer_reasoning": {
          "type": "string",
          "description": "Director's reasoning for renderer choice"
        }
      }
    },

    "video_prompt": {
      "type": "object",
      "required": ["beat_id", "prompt", "duration_seconds"],
      "properties": {
        "beat_id": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "prompt": { "type": "string", "minLength": 20 },
        "duration_seconds": { "type": "number", "minimum": 1 },
        "style": { "type": "string" }
      }
    },

    "memory_section": {
      "allOf": [
        { "$ref": "#/$defs/base_section" },
        {
          "type": "object",
          "properties": {
            "section_type": { "const": "memory" },
            "visual_beats": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/visual_beat" },
              "description": "Memory section MUST have exactly 5 flashcard visual beats"
            }
          },
          "required": ["section_type", "visual_beats"]
        }
      ]
    },

    "recap_section": {
      "allOf": [
        { "$ref": "#/$defs/base_section" },
        {
          "type": "object",
          "properties": {
            "section_type": { "const": "recap" },
            "visual_beats": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/visual_beat" },
              "description": "Recap section MUST have exactly 5 scene visual beats"
            }
          },
          "required": ["section_type", "visual_beats"]
        }
      ]
    },

    "generic_section": {
      "allOf": [
        { "$ref": "#/$defs/base_section" },
        {
          "type": "object",
          "properties": {
            "section_type": {
              "enum": ["intro", "content", "example", "quiz", "summary"]
            },
            "visual_beats": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/visual_beat" }
            }
          },
          "required": ["section_type", "visual_beats"]
        }
      ]
    },

    "narration_segment": {
      "type": "object",
      "required": ["segment_id", "text", "duration_seconds", "display_directives"],
      "properties": {
        "segment_id": { "type": "number" },
        "text": { "type": "string", "minLength": 1, "description": "Narration text for TTS audio - NOT for screen display" },
        "duration_seconds": { "type": "number", "minimum": 1 },
        "gesture_hint": {
          "type": "string",
          "description": "Avatar gesture hint - flexible string for various gestures"
        },
        "word_count": { "type": "number", "description": "Word count for recap segments" },
        "visual_content": {
          "type": "object",
          "description": "Structured displayable content from source document - shown on screen when text_layer=show",
          "properties": {
            "bullet_points": {
              "type": "array",
              "description": "Hierarchical bullet points extracted from source document",
              "items": {
                "type": "object",
                "required": ["level", "text"],
                "properties": {
                  "level": { "type": "integer", "enum": [1, 2], "description": "1=main bullet, 2=sub-bullet" },
                  "text": { "type": "string", "maxLength": 80, "description": "Original text from document - not rewritten" }
                }
              }
            },
            "formula": {
              "type": "string",
              "description": "LaTeX formula to display"
            },
            "labels": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Short labels for diagram annotation"
            }
          }
        },
        "display_directives": {
          "type": "object",
          "required": ["text_layer", "visual_layer", "avatar_layer"],
          "properties": {
            "text_layer": { "enum": ["show", "hide", "swap"] },
            "visual_layer": { "enum": ["show", "hide", "replace"] },
            "avatar_layer": { "enum": ["show", "hide", "gesture_only"] }
          },
          "description": "Layer visibility directives - text OR visual, never both visible"
        }
      }
    },

    "visual_beat": {
      "type": "object",
      "required": [
        "beat_id",
        "segment_id",
        "visual_beat_type",
        "description"
      ],
      "properties": {
        "beat_id": { "type": "string" },
        "segment_id": { "type": "number" },
        "visual_beat_type": {
          "type": "string",
          "description": "Type of visual beat - diagram, formula, process, video_clip, text_only, etc."
        },
        "description": { "type": "string", "minLength": 10 },
        "symbolic_overlay": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "content": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 4
            },
            "max_words": { "type": "number", "maximum": 4 }
          }
        }
      }
    }
  }
}
