modules = ["python-3.11"]
[agent]
expertMode = true
integrations = ["python_openrouter_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "espeak-ng", "ffmpeg", "ffmpeg-full", "freetype", "imagemagickBig", "jq", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pango", "pkg-config", "tcl", "texliveFull", "texliveMedium", "tk", "unzip", "zlib", "texliveSmall"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AI Education Server"

[[workflows.workflow]]
name = "AI Education Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python api/app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
