    {
      "segment_id": 2,
      "source_block_ids": [
        2
      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "Real numbers model continuous quantities \u2014 lengths, temperatures, speeds \u2014 where there are no \u201cgaps.\u201d This is unlike integers or rationals alone: between any two real numbers there are infinitely many others. The completeness (no gaps) of the real numbers is a foundational property used in calculus and analysis; at Class X level it simply means decimals can be extended indefinitely to approach limits.",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0
      }
    },
    {
      "segment_id": 3,
      "source_block_ids": [
        3,
        4
      ],
      "visual_content": {
        "content_type": "paragraph",
        "bullet_points": [
          {
            "level": 1,
            "text": "Every rational or irrational number is a real number."
          },
          {
            "level": 1,
            "text": "Real numbers can be positive, negative, or zero."
          },
          {
            "level": 1,
            "text": "Infinitely many rational and irrational numbers between any two distinct real numbers."
          }
        ],
        "verbatim_text": "#### Important Properties to Remember for Exams",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "show",
        "visual_layer": "hide",
        "avatar_layer": "show",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 4,
      "source_block_ids": [
        5,
        6,
        7,
        8
      ],
      "visual_content": {
        "content_type": "paragraph",
        "bullet_points": [
          {
            "level": 1,
            "text": "Definition: Natural numbers plus 0: 0, 1, 2, ..."
          },
          {
            "level": 1,
            "text": "Example: 0 (no apples left)."
          },
          {
            "level": 1,
            "text": "Property: All whole numbers are integers and hence real."
          }
        ],
        "verbatim_text": "## 2. CLASSIFICATION OF REAL NUMBERS",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
