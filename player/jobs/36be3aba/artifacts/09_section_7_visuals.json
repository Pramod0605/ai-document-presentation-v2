        "formula": "$$\\sin A = \\frac{BC}{AC} = \\frac{4}{5}, \\cos A = \\frac{AB}{AC} = \\frac{3}{5}$$",
        "formulas": [
          "$$\\sin A = \\frac{BC}{AC} = \\frac{4}{5}$$",
          "$$\\cos A = \\frac{AB}{AC} = \\frac{3}{5}$$"
        ],
