        "bullet_points": [],
        "formula": "$$AC^2 = AB^2 + BC^2$$",
        "formulas": [
          "$$\\text{In } \\triangle ABC, \\angle ABC = 90^\\circ$$",
          "$$\\text{\u2234 By Pythagoras theorem}$$",
          "$$AC^2 = AB^2 + BC^2$$",
          "$$\\Rightarrow AC^2 = 4^2 + 3^2 = 16 + 9 = 25$$",
          "$$\\Rightarrow AC = 5$$"
        ],
        "labels": [
          "Hypotenuse = 5"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
