  "segment_enrichments": [
    {
      "segment_id": 1,
      "visual_content": {
        "bullet_points": [
          {
            "level": 1,
            "text": "Prove angle equality using trigonometric ratios"
          },
          {
            "level": 1,
            "text": "Goal: If $\\sin B = \\sin Q$, then $\\angle B = \\angle Q$"
          }
        ]
      },
      "display_directives": {
        "text_layer": "show",
        "visual_layer": "hide",
        "avatar_layer": "show"
      }
    },
    {
      "segment_id": 2,
      "visual_content": {
        "bullet_points": [
          {
            "level": 1,
            "text": "Consider two right-angled triangles"
          },
          {
            "level": 1,
            "text": "Given: $\\sin B = \\sin Q$"
          },
          {
            "level": 1,
            "text": "$\\sin = \\frac{\\text{Opposite}}{\\text{Hypotenuse}}$"
          }
        ],
        "labels": [
          "Triangle ABC (angle B)",
          "Triangle PQR (angle Q)"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 3,
      "visual_content": {
        "formula": "$$\\sin B = \\sin Q$$",
        "formulas": [
          "$$\\Rightarrow \\frac{AC}{AB} = \\frac{PR}{PQ}$$",
          "$$\\Rightarrow \\frac{AC}{PR} = \\frac{AB}{PQ} = k \\quad \\text{--- (1)}$$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 4,
      "visual_content": {
        "formula": "$$BC = \\sqrt{AB^2 - AC^2} \\text{ [By Pythagoras theorem]}$$",
        "formulas": [
          "$$\\Rightarrow \\sqrt{k^2 PQ^2 - k^2 PR^2}$$",
          "$$\\Rightarrow k \\sqrt{PQ^2 - PR^2} \\text{ [from (1)]}$$",
          "$$QR = \\sqrt{PQ^2 - PR^2}$$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 5,
      "visual_content": {
        "formula": "$$\\Rightarrow \\frac{BC}{QR} = \\frac{k \\sqrt{PQ^2 - PR^2}}{\\sqrt{PQ^2 - PR^2}} = k \\quad \\text{--- (2)}$$",
        "formulas": [
          "From (1) and (2): $\\frac{AC}{PR} = \\frac{AB}{PQ} = \\frac{BC}{QR} = k$",
          "Triangles are similar.",
          "Therefore, $\\angle B = \\angle Q$."
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    }
  ]
}