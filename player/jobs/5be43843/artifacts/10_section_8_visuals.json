        "bullet_points": [
          {
            "level": 1,
            "text": "Example 1: Two numbers"
          },
          {
            "level": 1,
            "text": "Sum = 10, Difference = 2"
          },
          {
            "level": 1,
            "text": "Let numbers be x, y"
          },
          {
            "level": 1,
            "text": "$$x + y = 10$$"
          },
          {
            "level": 1,
            "text": "$$x - y = 2$$"
          }
        ],
        "verbatim_text": "#### Example 1",
        "has_inline_latex": false
