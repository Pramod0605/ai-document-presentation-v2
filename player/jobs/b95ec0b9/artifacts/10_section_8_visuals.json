      "visual_content": {
        "content_type": "paragraph",
        "bullet_points": [
          {
            "level": 1,
            "text": "Opposite = y"
          },
          {
            "level": 1,
            "text": "Adjacent = x"
          },
          {
            "level": 1,
            "text": "Hypotenuse = r"
          },
          {
            "level": 1,
            "text": "$\\sin \\theta = \\frac{y}{r}$"
          },
          {
            "level": 1,
            "text": "$\\cos \\theta = \\frac{x}{r}$"
          }
        ],
        "verbatim_text": "![Diagram showing two right-angled triangles, labeled 1 and 2, illustrating the sides (Opposite, Adjacent, Hypotenuse) relative to an angle A.](8c378a184b5ae4d1605cb74d7b7a7e3f_img.jpg)",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [],
      "visual_content": {
        "content_type": "ordered_list",
        "ordered_list": [
          "Substitute: $(\\frac{y}{r})^2 + (\\frac{x}{r})^2$",
          "Simplify: $\\frac{y^2}{r^2} + \\frac{x^2}{r^2} = \\frac{y^2 + x^2}{r^2}$",
          "Pythagorean Theorem: $x^2 + y^2 = r^2$",
          "Replace: $\\frac{r^2}{r^2} = 1$",
          "Identity confirmed: $\\sin^2 \\theta + \\cos^2 \\theta = 1$"
        ]
      },
