        "formulas": [
          "$$AC^2 = AB^2 + BC^2$$",
          "$$\\Rightarrow AC^2 = 4^2 + 3^2 = 16 + 9 = 25$$",
          "$$\\Rightarrow AC = 5$$"
        ],
        "verbatim_text": "In  $\\triangle ABC$ ,  $\\angle ABC = 90^\\circ$",
        "has_inline_latex": true
