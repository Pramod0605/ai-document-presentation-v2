      "segment_id": 4,
      "visual_beat_type": "formula",
      "description": "Rearranging the proportion and introducing constant 'k'.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "AC/PR = AB/PQ = k",
          "AC = k PR",
          "AB = k PQ"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_5",
      "segment_id": 5,
      "visual_beat_type": "process",
      "description": "Using Pythagorean theorem to find remaining sides and proving similarity.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Pythagorean Theorem",
          "BC = k QR",
          "Similar Triangles",
          "\u2220B = \u2220Q"
        ],
        "max_words": 4
      }
    }
