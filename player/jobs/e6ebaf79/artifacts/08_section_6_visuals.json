      "visual_content": {
        "bullet_points": [],
        "formula": "$\\sin B = \\sin Q$",
        "formulas": [
          "$\\sin B = \\sin Q$",
          "$\\frac{AC}{AB} = \\frac{PR}{PQ}$"
        ],
        "labels": [
          "Opposite",
          "Hypotenuse"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
