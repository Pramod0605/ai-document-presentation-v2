      "visual_content": {
        "bullet_points": [],
        "formula": "$\\frac{AC}{PR} = \\frac{AB}{PQ}$",
        "formulas": [
          "$\\frac{AC}{PR} = \\frac{AB}{PQ}$"
        ],
        "labels": []
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 7,
      "visual_content": {
        "bullet_points": [],
        "formula": "$\\frac{AC}{PR} = \\frac{AB}{PQ} = k$",
        "formulas": [
          "$\\frac{AC}{PR} = \\frac{AB}{PQ} = k \\quad \\text{--- (1)}$",
          "$AC = k \\cdot PR$",
          "$AB = k \\cdot PQ$"
        ],
        "labels": [
          "Common ratio 'k'"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 8,
      "visual_content": {
        "bullet_points": [],
        "formula": "$BC^2 = AB^2 - AC^2$",
        "formulas": [
          "$BC = \\sqrt{AB^2 - AC^2} \\text{ [By Pythagoras theorem]}$"
        ],
        "labels": [
          "Pythagorean Theorem",
          "Triangle ABC"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 9,
      "visual_content": {
        "bullet_points": [],
        "formula": "$BC = k \\sqrt{PQ^2 - PR^2}$",
        "formulas": [
          "$\\Rightarrow \\sqrt{k^2 PQ^2 - k^2 PR^2}$",
          "$\\Rightarrow k \\sqrt{PQ^2 - PR^2} \\text{ [from (1)]}$"
        ],
        "labels": []
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 10,
      "visual_content": {
        "bullet_points": [],
        "formula": "$QR = \\sqrt{PQ^2 - PR^2}$",
        "formulas": [
          "$QR = \\sqrt{PQ^2 - PR^2}$"
        ],
        "labels": [
          "Triangle PQR"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 11,
      "visual_content": {
        "bullet_points": [],
        "formula": "$\\frac{BC}{QR} = k$",
        "formulas": [
          "$\\Rightarrow \\frac{BC}{QR} = \\frac{k \\sqrt{PQ^2 - PR^2}}{\\sqrt{PQ^2 - PR^2}} = k \\quad \\text{--- (2)}$"
        ],
        "labels": []
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only"
      }
    },
    {
      "segment_id": 12,
      "visual_content": {
        "bullet_points": [
          {
            "level": 1,
            "text": "From (1) and (2):"
          },
          {
            "level": 1,
            "text": "$\\frac{AC}{PR} = \\frac{AB}{PQ} = \\frac{BC}{QR} = k$"
          }
        ],
        "formula": null,
        "formulas": [],
        "labels": [
          "Proportional Sides",
          "Ratio 'k'"
        ]
      },
