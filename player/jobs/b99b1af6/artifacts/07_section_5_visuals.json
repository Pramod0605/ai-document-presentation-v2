    {
      "segment_id": 3,
      "source_block_ids": [
        41
      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "![Diagram showing two right-angled triangles, BAC and QPR, right-angled at C and R respectively. Angle B is equal t",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 4,
      "source_block_ids": [
        33
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$\\sin B = \\frac{AC}{AB}$",
          "$\\sin Q = \\frac{PR}{PQ}$"
        ],
        "formula": "$$\\Rightarrow \\frac{AC}{AB} = \\frac{PR}{PQ}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [
        32,
        33,
        34
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$\\sin B = \\sin Q$",
          "$\\Rightarrow \\frac{AC}{AB} = \\frac{PR}{PQ}$",
          "$\\Rightarrow \\frac{AC}{PR} = \\frac{AB}{PQ} = k \\quad \\text{--- (1)}$"
        ],
        "formula": "$$\\sin B = \\sin Q$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 6,
      "source_block_ids": [
        35
      ],
      "visual_content": {
        "content_type": "formula",
        "formula": "$$BC = \\sqrt{AB^2 - AC^2} \\text{ [By Pythagoras theorem]}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 7,
      "source_block_ids": [
        36,
        37,
        38,
        39
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$QR = \\sqrt{PQ^2 - PR^2}$$",
          "$$\\Rightarrow \\frac{BC}{QR} = \\frac{k \\sqrt{PQ^2 - PR^2}}{\\sqrt{PQ^2 - PR^2}} = k \\quad \\text{--- (2)}$$"
        ],
        "formula": "$$\\Rightarrow \\sqrt{k^2 PQ^2 - k^2 PR^2}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
