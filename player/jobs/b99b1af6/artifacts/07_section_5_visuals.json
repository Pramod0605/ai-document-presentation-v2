      "visual_content": {
        "content_type": "paragraph",
        "formulas": [
          "Given: B, Q are acute angles",
          "$\\sin B = \\sin Q$",
          "Prove: $\\angle B = \\angle Q$"
        ],
        "verbatim_text": "**Example 2:** If B and Q are acute angles such that  $\\sin B = \\sin Q$ , then prove that  $\\angle B = \\angle Q$ .",
        "has_inline_latex": true
      },
      "display_directives": {
