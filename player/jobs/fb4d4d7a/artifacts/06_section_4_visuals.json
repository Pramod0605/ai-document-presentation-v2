      "visual_content": {
        "content_type": "formula",
        "formula": "$$AC^2 = AB^2 + BC^2$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
