        "content_type": "bullet_list",
        "bullet_points": [
          {
            "level": 1,
            "text": "$\\sin^2\\theta = \\left(\\frac{\\text{Opposite}}{\\text{Hypotenuse}}\\right)^2$"
          },
          {
            "level": 1,
            "text": "$\\cos^2\\theta = \\left(\\frac{\\text{Adjacent}}{\\text{Hypotenuse}}\\right)^2$"
          }
        ]
      },
      "display_directives": {
