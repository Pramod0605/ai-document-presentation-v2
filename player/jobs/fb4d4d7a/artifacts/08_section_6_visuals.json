        "content_type": "bullet_list",
        "bullet_points": [
          {
            "level": 1,
            "text": "$\\sin A = \\frac{\\text{Opposite}}{\\text{Hypotenuse}}$"
          },
          {
            "level": 1,
            "text": "$\\cos A = \\frac{\\text{Adjacent}}{\\text{Hypotenuse}}$"
          }
        ]
      },
      "display_directives": {
