      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$\\cos A = \\frac{\\text{Adjacent}}{\\text{Hypotenuse}} = \\frac{x}{x\\sqrt{2}} = \\frac{1}{\\sqrt{2}}$",
          "$2\\sin A \\cos A = 2 \\left(\\frac{1}{\\sqrt{2}}\\right) \\left(\\frac{1}{\\sqrt{2}}\\right)$",
          "$ = 2 \\left(\\frac{1}{2}\\right) = 1$"
        ]
      },
