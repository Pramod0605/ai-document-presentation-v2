        "content_type": "formula",
        "formulas": [
          "$\\sin A = \\frac{\\text{Opposite}}{\\text{Hypotenuse}} = \\frac{x}{x\\sqrt{2}} = \\frac{1}{\\sqrt{2}}$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
