        "formulas": [
          "$AC^2 = AB^2 + BC^2$",
          "$AC^2 = x^2 + x^2 = 2x^2$",
          "$AC = \\sqrt{2x^2} = x\\sqrt{2}$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
