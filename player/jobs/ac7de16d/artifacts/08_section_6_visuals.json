{
  "section_id": "section_6",
  "visual_beats": [
    {
      "beat_id": "beat_1",
      "segment_id": 1,
      "visual_beat_type": "text_only",
      "description": "Introduction to proving angle equality using trigonometric ratios.",
      "symbolic_overlay": {
        "enabled": false,
        "content": [],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_2",
      "segment_id": 2,
      "visual_beat_type": "diagram",
      "description": "Introduce two right-angled triangles with angles B and Q.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Triangle 1",
          "Triangle 2",
          "sin B",
          "sin Q"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_3",
      "segment_id": 3,
      "visual_beat_type": "text_only",
      "description": "State the goal: prove angle B equals angle Q.",
      "symbolic_overlay": {
        "enabled": false,
        "content": [],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_4",
      "segment_id": 4,
      "visual_beat_type": "diagram",
      "description": "Display two right-angled triangles ABC and PQR with given condition.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Triangle ABC",
          "Triangle PQR",
          "sin B = sin Q"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_5",
      "segment_id": 5,
      "visual_beat_type": "formula",
      "description": "Recall definition of sine ratio.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Sine",
          "Opposite",
          "Hypotenuse"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_6",
      "segment_id": 6,
      "visual_beat_type": "formula",
      "description": "Show sine ratios for both triangles.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "sin B",
          "AC/AB",
          "sin Q",
          "PR/PQ"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_7",
      "segment_id": 7,
      "visual_beat_type": "formula",
      "description": "Equate the sine ratios.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "sin B = sin Q",
          "AC/AB = PR/PQ"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_8",
      "segment_id": 8,
      "visual_beat_type": "formula",
      "description": "Rearrange the equation and introduce 'k'.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Rearrange",
          "Ratio 'k'"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_9",
      "segment_id": 9,
      "visual_beat_type": "formula",
      "description": "Express sides in terms of 'k'.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "AC = k PR",
          "AB = k PQ"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_10",
      "segment_id": 10,
      "visual_beat_type": "formula",
      "description": "Apply Pythagorean theorem to find BC.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Pythagorean Theorem",
          "BC squared"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_11",
      "segment_id": 11,
      "visual_beat_type": "formula",
      "description": "Substitute 'k' values into BC squared equation.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Substitute 'k'",
          "BC squared"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_12",
      "segment_id": 12,
      "visual_beat_type": "formula",
      "description": "Factor out k squared and take square root for BC.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Factor k squared",
          "Square Root",
          "BC"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_13",
      "segment_id": 13,
      "visual_beat_type": "formula",
      "description": "Apply Pythagorean theorem to find QR.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Pythagorean Theorem",
          "QR"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_14",
      "segment_id": 14,
      "visual_beat_type": "formula",
      "description": "Form the ratio of BC to QR.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Ratio",
          "BC / QR"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_15",
      "segment_id": 15,
      "visual_beat_type": "formula",
      "description": "Show cancellation of terms, resulting in 'k'.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "Cancel Terms",
          "Result 'k'"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_16",
      "segment_id": 16,
      "visual_beat_type": "formula",
      "description": "Summarize the equal ratios of corresponding sides.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "AC/PR = AB/PQ",
          "= BC/QR"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_17",
      "segment_id": 17,
      "visual_beat_type": "text_only",
      "description": "State that ratios of corresponding sides are equal to 'k'.",
      "symbolic_overlay": {
        "enabled": false,
        "content": [],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_18",
      "segment_id": 18,
      "visual_beat_type": "diagram",
      "description": "Conclude similarity by SSS criterion.",
      "symbolic_overlay": {
        "enabled": true,
        "content": [
          "SSS Similarity",
          "Triangle ABC ~ PQR"
        ],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_19",
      "segment_id": 19,
      "visual_beat_type": "text_only",
      "description": "Conclude angle equality from triangle similarity.",
      "symbolic_overlay": {
        "enabled": false,
        "content": [],
        "max_words": 4
      }
    },
    {
      "beat_id": "beat_20",
