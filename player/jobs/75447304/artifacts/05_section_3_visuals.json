      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "A real number is any number that can be represented as a point on the number line. The set of real numbers is denoted by  $\\mathbb{R}$ .",
        "has_inline_latex": true
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
