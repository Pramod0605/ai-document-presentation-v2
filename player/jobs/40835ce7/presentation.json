      "section_title": "Key Concepts",
      "flashcards": [
        {
          "card_id": 1,
          "front": "What is the definition of Force?",
          "back": "A push or a pull that can cause an object with mass to change its velocity (accelerate). Its standard unit is the Newton (N)."
        },
        {
          "card_id": 2,
          "front": "What is Mass?",
          "back": "A measure of an object's inertia, or its resistance to acceleration when a force is applied. Its standard unit is the kilogram (kg)."
        },
        {
          "card_id": 3,
          "front": "What is the formula for Newton's Second Law?",
          "back": "F = ma (Force = mass \u00d7 acceleration)"
        },
        {
          "card_id": 4,
          "front": "What does it mean that acceleration is 'inversely proportional to mass'?",
          "back": "If the force stays the same, an object with a larger mass will have a smaller acceleration, and an object with a smaller mass will have a larger acceleration."
        },
        {
          "card_id": 5,
          "front": "What units make up one Newton (N) of force?",
          "back": "1 Newton is equal to 1 kilogram-meter per second squared (1 N = 1 kg\u00b7m/s\u00b2)."
        }
      ]
