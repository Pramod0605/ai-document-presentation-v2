    {
      "segment_id": 4,
      "source_block_ids": [],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$AB^2 + BC^2 = AC^2$",
          "$x^2 + BC^2 = (2x)^2$",
          "$x^2 + BC^2 = 4x^2$",
          "$BC^2 = 3x^2$",
          "$BC = x\\sqrt{3}$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$\\sin C = \\frac{\\text{Opposite}}{\\text{Hypotenuse}} = \\frac{AB}{AC} = \\frac{x}{2x} = \\frac{1}{2}$",
          "$\\cos C = \\frac{\\text{Adjacent}}{\\text{Hypotenuse}} = \\frac{BC}{AC} = \\frac{x\\sqrt{3}}{2x} = \\frac{\\sqrt{3}}{2}$",
          "$\\tan C = \\frac{\\text{Opposite}}{\\text{Adjacent}} = \\frac{AB}{BC} = \\frac{x}{x\\sqrt{3}} = \\frac{1}{\\sqrt{3}}$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    }
