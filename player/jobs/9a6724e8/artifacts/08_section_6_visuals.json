  "segment_enrichments": [
    {
      "segment_id": 1,
      "source_block_ids": [
        31
      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "**Example 2:** If B and Q are acute angles such that  $\\sin B = \\sin Q$ , then prove that  $\\angle B = \\angle Q$ .",
        "has_inline_latex": true
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 2,
      "source_block_ids": [
        32,
        33
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$\\sin B = \\sin Q$$",
          "$$\\Rightarrow \\frac{AC}{AB} = \\frac{PR}{PQ}$$"
        ],
        "formula": "$$\\sin B = \\sin Q$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 3,
      "source_block_ids": [
        34
      ],
      "visual_content": {
        "content_type": "formula",
        "formula": "$$\\Rightarrow \\frac{AC}{PR} = \\frac{AB}{PQ} = k \\quad \\text{--- (1)}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 4,
      "source_block_ids": [
        35,
        36,
        37
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$BC = \\sqrt{AB^2 - AC^2} \\text{ [By Pythagoras theorem]}$$",
          "$$\\Rightarrow \\sqrt{k^2 PQ^2 - k^2 PR^2}$$",
          "$$\\Rightarrow k \\sqrt{PQ^2 - PR^2} \\text{ [from (1)]}$$"
        ],
        "formula": "$$BC = \\sqrt{AB^2 - AC^2} \\text{ [By Pythagoras theorem]}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [
        38,
        39,
        40
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$QR = \\sqrt{PQ^2 - PR^2}$$",
          "$$\\Rightarrow \\frac{BC}{QR} = \\frac{k \\sqrt{PQ^2 - PR^2}}{\\sqrt{PQ^2 - PR^2}} = k \\quad \\text{--- (2)}$$"
        ],
        "verbatim_text": "From (1) and (2),",
        "formula": "$$QR = \\sqrt{PQ^2 - PR^2}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    }
  ]
