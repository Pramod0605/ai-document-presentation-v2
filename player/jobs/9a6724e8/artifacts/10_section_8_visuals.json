      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$AC^2 = AB^2 + BC^2$$",
          "$$\\Rightarrow AC^2 = 4^2 + 3^2 = 16 + 9 = 25$$",
          "$$\\Rightarrow AC = 5$$",
          "$$\\sin A = \\frac{BC}{AC} = \\frac{4}{5}, \\cos A = \\frac{AB}{AC} = \\frac{3}{5}$$"
        ],
        "formula": "$$AC^2 = AB^2 + BC^2$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
