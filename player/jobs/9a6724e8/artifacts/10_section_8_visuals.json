      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "![Diagram of a right-angled triangle ABC, right-angled at B. Side AB = 3, BC = 4, and AC = 5.](df9ce5affceb4ff1e9e8fd8e3ff0c1bd_img.jpg)",
        "has_inline_latex": false
      },
      "display_directives": {
