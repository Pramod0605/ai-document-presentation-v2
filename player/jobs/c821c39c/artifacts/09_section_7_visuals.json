      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "![Diagram of a right-angled triangle ABC, right-angled at B. Side AB = 3, BC = 4, and AC = 5.](df9ce5affceb4ff1e9e8fd8e3ff0c1bd_img.jpg)"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 4,
      "source_block_ids": [
        24,
        25,
        26
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$AC^2 = AB^2 + BC^2$$",
          "$$\\Rightarrow AC^2 = 4^2 + 3^2 = 16 + 9 = 25$$",
          "$$\\Rightarrow AC = 5$$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [
        27,
        28
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$\\sin A = \\frac{BC}{AC} = \\frac{4}{5}, \\cos A = \\frac{AB}{AC} = \\frac{3}{5}, \\tan A = \\frac{BC}{AB} = \\frac{4}{3}$$",
          "$$\\csc A = \\frac{AC}{BC} = \\frac{5}{4}, \\sec A = \\frac{AC}{AB} = \\frac{5}{3}, \\cot A = \\frac{AB}{BC} = \\frac{3}{4}$$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": null
      }
