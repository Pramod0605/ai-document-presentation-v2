      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "![Diagram of a right-angled triangle ABC, right-angled at B. Side AB = 3, BC = 4, and AC = 5.](df9ce5affceb4ff1e9e8fd8e3ff0c1bd_img.jpg)"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 3,
      "source_block_ids": [
        22,
        29
      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "In  $\\triangle ABC$ ,  $\\angle ABC = 90^\\circ$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 4,
      "source_block_ids": [
        23,
        24
      ],
      "visual_content": {
        "content_type": "formula",
        "formula": "$$AC^2 = AB^2 + BC^2$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 5,
      "source_block_ids": [
        25,
        26
      ],
      "visual_content": {
        "content_type": "formula",
        "formulas": [
          "$$\\Rightarrow AC^2 = 4^2 + 3^2 = 16 + 9 = 25$$",
          "$$\\Rightarrow AC = 5$$"
        ]
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 6,
      "source_block_ids": [
        27
      ],
      "visual_content": {
        "content_type": "formula",
        "formula": "$$\\sin A = \\frac{BC}{AC} = \\frac{4}{5}, \\cos A = \\frac{AB}{AC} = \\frac{3}{5}, \\tan A = \\frac{BC}{AB} = \\frac{4}{3}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
      "segment_id": 7,
      "source_block_ids": [
        28
      ],
      "visual_content": {
        "content_type": "formula",
        "formula": "$$\\csc A = \\frac{AC}{BC} = \\frac{5}{4}, \\sec A = \\frac{AC}{AB} = \\frac{5}{3}, \\cot A = \\frac{AB}{BC} = \\frac{3}{4}$$"
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
