      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "## PAIR OF LINEAR EQUATIONS IN TWO VARIABLES",
        "has_inline_latex": false
      },
      "display_directives": {
        "text_layer": "show",
        "visual_layer": "hide",
        "avatar_layer": "show",
        "flip_timing_sec": null
