    {
      "segment_id": 3,
      "source_block_ids": [
        41,
        43,
        44
      ],
      "visual_content": {
        "content_type": "paragraph",
        "verbatim_text": "A pair of linear equations in two variables consists of two linear equations involving the same two variables, usually  $x$  and  $y$ . Each equation is of degree one. The solution of the pair is the value of the variables that satisfies both equations at the same time.",
        "has_inline_latex": true
      },
      "display_directives": {
        "text_layer": "hide",
        "visual_layer": "show",
        "avatar_layer": "gesture_only",
        "flip_timing_sec": 0.0
      }
    },
    {
