        "bullet_points": [
          {
            "level": 1,
            "text": "Foundation for higher mathematics"
          },
          {
            "level": 1,
            "text": "Coordinate geometry, algebraic reasoning"
          },
          {
            "level": 1,
            "text": "High weightage in examinations"
          },
          {
            "level": 1,
            "text": "Powerful mathematical tool"
          }
        ],
        "verbatim_text": "This chapter builds a strong foundation for coordinate geometry, algebraic reasoning, and higher mathematics such as matrices, determinants, and linear programming. From an examination point of view, this chapter carries high weightage and includes case-study and HOTS questions regularly.",
        "has_inline_latex": false
